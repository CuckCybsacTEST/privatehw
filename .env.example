# App
APP_URL=http://localhost:5173
MEDIA_TOKEN_SECRET=change-me-to-a-long-random-string

# Supabase public client
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
# Optional legacy fallback:
# VITE_SUPABASE_ANON_KEY=eyJ...

# Supabase server/admin
SUPABASE_SERVICE_ROLE_KEY=eyJ_service_role_key

# Telegram login
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Google Drive
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=drive-service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
GOOGLE_DRIVE_API_KEY=

# Optional translation service
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
